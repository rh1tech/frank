;
; ws2812.pio — single-wire NRZ driver for the WS2812B-2020 (LD1) on the
; master's GPIO46. Standard three-phase bit cell: the line always rises,
; the data bit decides when it falls, and it is always low at the end.
;
;   T1 + T2 + T3 = 10 cycles per bit; the SM clock is divided so that
;   comes to 1.25 us, matching the WS2812B timing spec.

.program ws2812
.side_set 1

.define public T1 2
.define public T2 5
.define public T3 3

.wrap_target
bitloop:
    out x, 1        side 0 [T3 - 1]   ; low tail of the previous bit
    jmp !x do_zero  side 1 [T1 - 1]   ; rise; branch on the bit value
do_one:
    jmp bitloop     side 1 [T2 - 1]   ; stay high -> long pulse = 1
do_zero:
    nop             side 0 [T2 - 1]   ; fall early    -> short pulse = 0
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void ws2812_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_config c = ws2812_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    /* 24-bit GRB pushed MSB-first from the top of the OSR. */
    sm_config_set_out_shift(&c, false /* shift left */, true /* autopull */, 24);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    const float cycles_per_bit = ws2812_T1 + ws2812_T2 + ws2812_T3;
    const float bit_freq = 800000.0f;   /* 1.25 us per bit */
    sm_config_set_clkdiv(&c, (float)clock_get_hz(clk_sys) / (bit_freq * cycles_per_bit));

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
